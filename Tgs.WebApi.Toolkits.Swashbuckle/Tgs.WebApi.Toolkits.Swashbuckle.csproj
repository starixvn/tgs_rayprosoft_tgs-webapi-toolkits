<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tgs.WebApi.Toolkits</RootNamespace>
    <PackageId>Tgs.WebApi.Toolkits.Swashbuckle</PackageId>
    <Version>0.3.0</Version>
    <Authors>Raypro</Authors>
    <PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-webapi-toolkits</PackageProjectUrl>
    <Description>分割 swagger 處理部分的套件</Description>
    <RepositoryUrl>https://gitlab.com/rayprosoft/tgs-webapi-toolkits.git</RepositoryUrl>
    <PackageTags>WebApi Tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tgs.WebApi.Toolkits\Tgs.WebApi.Toolkits.csproj" />
  </ItemGroup>

</Project>
